#question-scroll {
    width: 4fr;
    scrollbar-size: 0 0;
}

#sidebar {
    width: 1fr;
    height: 100%;
    border-right: solid white;
    overflow-y: auto;
    padding: 1;
    scrollbar-size: 0 0;
}

#sidebar-title {
    text-style: bold;
    padding-bottom: 1;
    border-bottom: solid white;
    margin-bottom: 1;
}

.sidebar-item {
    padding: 0 1;
    margin-bottom: 1;
}

.sidebar-item.current {
    background: $accent 50%;
}

#sidebar.hidden {
    display: none;
}

#form-header {
    margin-bottom: 2;
    width: 100%;
    text-wrap: wrap;
}

Label {
    margin-top: 1;
    margin-bottom: 1;
    width: 100%;
    text-wrap: wrap;
}

Input {
    margin-bottom: 2;
    border: tall white;
}

Input:focus {
    border: tall $accent;
}

DatePicker {
    margin-bottom: 2;
}

DatePicker > #input-control {
    border: tall white;
    padding: 0;
}

DatePicker > #input-control:focus-within {
    border: tall $accent;
}

DatePicker #date-input,
DatePicker #input-control Button,
DatePicker #input-control AbstractInput {
    border: none;
}

RadioSet {
    margin-bottom: 2;
}

Switch {
    margin-bottom: 2;
}

SelectionList {
    margin-bottom: 2;
}

TextArea {
    margin-bottom: 2;
    border: tall white;
    min-height: 3;
}

TextArea:focus {
    border: tall $accent;
}

#confirm-tip {
    margin-top: 1;
    margin-bottom: 1;
}

#grade-score {
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

#grade-review {
    height: 55%;
    border: round $accent;
    padding: 1;
    margin-bottom: 1;
    scrollbar-size-vertical: 1;
}

#grade-review Static {
    margin-top: 1;
    margin-bottom: 1;
    width: 100%;
    text-wrap: wrap;
}

.submit-screen {
    scrollbar-size-vertical: 1;
}

#confirm-identity {
    margin-top: 1;
    margin-bottom: 1;
}

#restart,
#quit {
    margin: 1 4;
}

/* Code block styling */
Static > .code {
    background: $surface;
    padding: 1;
    margin-bottom: 1;
}

/* URL hint styling */
Static > .url {
    color: $accent;
    text-style: italic;
    margin-bottom: 1;
}

#question-counter {
    text-style: italic;
    color: $text-muted;
    margin-top: 1;
    margin-bottom: 1;
}

#submit {
    margin-top: 1;
    margin-bottom: 1;
    border: tall white;
}

/* Command palette styling for readability and contrast */

CommandPalette > Vertical {
    padding: 1;
    background: $surface;
}

CommandPalette #--input {
    border: hkey white;
    padding-top: 1;
}

CommandPalette CommandList {
    color: $text;
}

CommandPalette CommandList > .option-list--option {
    color: $text;
    background: $surface;
}

CommandPalette CommandList > .option-list--option-highlighted {
    color: $text;
    background: $accent;
}
